# Environment Configuration
APP_ENV=development
DEBUG=true
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL 18)
POSTGRES_USER=denial_app
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=denial_management
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://denial_app:your_secure_password_here@127.0.0.1:5432/denial_management

# Ollama & Local Model Settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.0

# Retrieval & Embeddings
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
FAISS_INDEX_DIR=data/indexes
